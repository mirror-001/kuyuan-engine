{
  "标准": "库元/引擎/v0",
  "包": "demo",
  "版本": "0.1.0",
  "三问": {
    "可推翻": "跑两拍：t1 应 计数=1、倍值=0；t2 应 计数=2、倍值=2；任何一步不符即推翻。",
    "论域": "整数域；两模块、一经接线；验证同步单遍（读旧写新）。",
    "检验者": "同上——断言测试；重点断言“倍值滞后一拍”。"
  },
  "模块": [
    {
      "id": "demo.计数器",
      "输入": [ { "名": "步长", "类型": "整数", "默认": 1 } ],
      "输出": [ { "名": "计数", "类型": "整数" } ],
      "变量": [
        { "名": "计数", "类型": "整数", "初值": 0 }
      ],
      "公式": [
        { "名": "计数.下一", "目标": "计数",
          "表达式": ["加", ["引用", "demo.计数器.计数"], ["引用", "demo.计数器.步长"]] }
      ]
    },
    {
      "id": "demo.加倍器",
      "输入": [ { "名": "入值", "类型": "整数", "默认": 0 } ],
      "输出": [ { "名": "倍值", "类型": "整数" } ],
      "变量": [
        { "名": "倍值", "类型": "整数", "初值": 0 }
      ],
      "公式": [
        { "名": "倍值.下一", "目标": "倍值",
          "表达式": ["乘", ["引用", "demo.加倍器.入值"], ["字面", 2]] }
      ]
    }
  ],
  "关系": [
    { "类型": "接线", "从": "demo.计数器.计数", "到": "demo.加倍器.入值" }
  ]
}
