{
  "标准": "库元/引擎/v0",
  "包": "demo",
  "版本": "0.1.0",
  "三问": {
    "可推翻": "跑一拍后，若快照中 计数 ≠ 1（初值 0 ＋ 步长 1），或日志无 {旧:0, 新:1} 记录，即推翻。",
    "论域": "整数域；单模块、无接线；tick 数任意。",
    "检验者": "引擎最小闭环的断言测试（对事件流与快照做匹配）。"
  },
  "模块": [
    {
      "id": "demo.计数器",
      "输入": [ { "名": "步长", "类型": "整数", "默认": 1 } ],
      "输出": [ { "名": "计数", "类型": "整数" } ],
      "变量": [
        { "名": "计数", "类型": "整数", "初值": 0 }
      ],
      "公式": [
        { "名": "计数.下一", "目标": "计数",
          "表达式": ["加", ["引用", "demo.计数器.计数"], ["引用", "demo.计数器.步长"]] }
      ]
    }
  ],
  "关系": []
}
